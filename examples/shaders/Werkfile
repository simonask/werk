default out-dir = "../../target/examples/shaders"
default target = "build"

let tar = which "tar"

build "target/%.(frag|vert|comp).spv" {
    from "{%}.{0}"
    run "glslc <in> -o <out>"
}

build "target/assets.tar.gz" {
    from glob "*.\{frag,vert,comp\}" | map "{}.spv"
    run "{tar} -zcf <out> <in*>"
}

task build {
    build "target/assets.tar.gz"
}
